// Smart Money Concepts reconstruction: structure, OB, breakers, FVG and reversal zones.
// SPDX-License-Identifier: MPL-2.0
//@version=6
indicator("Select Terminal - Smart Ranges SMC [Event Loop]", "Select Smart Ranges",
     overlay=true, max_boxes_count=400, max_lines_count=200, max_labels_count=300, dynamic_requests=true)

string G_STRUCTURE = "Structure"
int swingLen = input.int(5, "Swing length", minval=2, maxval=30, group=G_STRUCTURE)
int obSearch = input.int(12, "Order-block search bars", minval=2, maxval=40, group=G_STRUCTURE)
int keepOb = input.int(8, "Keep order blocks", minval=1, maxval=50, group=G_STRUCTURE)
int keepFvg = input.int(12, "Keep FVGs", minval=1, maxval=80, group=G_STRUCTURE)
int maxAge = input.int(300, "Maximum zone age", minval=20, maxval=500, group=G_STRUCTURE)
string mitigation = input.string("Wick", "Mitigation", options=["Wick", "Close", "Midpoint"], group=G_STRUCTURE)
string textSize = input.string("Tiny", "Text size", options=["Tiny", "Small", "Normal"], group=G_STRUCTURE)
bool showOb = input.bool(true, "Show order blocks", group=G_STRUCTURE)
bool showObActivity = input.bool(true, "Show OB activity", group=G_STRUCTURE)
bool showBreakers = input.bool(true, "Show breaker blocks", group=G_STRUCTURE)
bool showMetrics = input.bool(true, "Show OB strength", group=G_STRUCTURE)
bool showFvg = input.bool(true, "Show fair value gaps", group=G_STRUCTURE)
string fvgTheme = input.string("Classic", "FVG theme", options=["Classic", "Imbalance"], group=G_STRUCTURE)
string fvgMitigation = input.string("Wick", "FVG mitigation", options=["Wick", "Close", "Midpoint"], group=G_STRUCTURE)
bool extendFvg = input.bool(true, "Extend FVGs", group=G_STRUCTURE)
bool showSignals = input.bool(true, "Show OB/FVG signals", group=G_STRUCTURE)
bool showObSignals = input.bool(true, "Show OB signals", group=G_STRUCTURE)
bool showFvgSignals = input.bool(true, "Show FVG signals", group=G_STRUCTURE)
bool showPredict = input.bool(true, "Show projected structure", group=G_STRUCTURE)
bool showSmartRev = input.bool(true, "Show smart reversals", group=G_STRUCTURE)

string G_HTF = "Higher Timeframe"
bool showHtf = input.bool(true, "Show HTF swing ranges", group=G_HTF)
string htf = input.timeframe("240", "HTF", group=G_HTF)
bool showFvgHtf = input.bool(false, "Show HTF FVG range", group=G_HTF)
string smartRevHtf = input.timeframe("60", "Smart reversal HTF", group=G_HTF)
string statsType = input.string("Detailed", "Stats", options=["Off", "Summary", "Detailed"], group=G_HTF)
string statsPosition = input.string("Top Right", "Stats position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=G_HTF)

f_text_size() =>
    textSize == "Tiny" ? size.tiny : textSize == "Small" ? size.small : size.normal

f_stats_position() =>
    statsPosition == "Top Left" ? position.top_left : statsPosition == "Bottom Right" ? position.bottom_right :
         statsPosition == "Bottom Left" ? position.bottom_left : position.top_right

float atr = ta.atr(14)
float volMa = ta.sma(volume, 30)
float ph = ta.pivothigh(high, swingLen, swingLen)
float pl = ta.pivotlow(low, swingLen, swingLen)
var float lastSwingHigh = na
var float lastSwingLow = na
if not na(ph)
    lastSwingHigh := ph
if not na(pl)
    lastSwingLow := pl

bool bullBos = barstate.isconfirmed and not na(lastSwingHigh) and close > lastSwingHigh and close[1] <= lastSwingHigh
bool bearBos = barstate.isconfirmed and not na(lastSwingLow) and close < lastSwingLow and close[1] >= lastSwingLow
var int structureTrend = 0
bool bullChoch = bullBos and structureTrend < 0
bool bearChoch = bearBos and structureTrend > 0
if bullBos
    structureTrend := 1
if bearBos
    structureTrend := -1

plotshape(bullBos and not bullChoch, "Bull BOS", text="BOS+", style=shape.labelup,
     location=location.belowbar, color=color.aqua, textcolor=color.black, size=size.tiny)
plotshape(bullChoch, "Bull CHOCH", text="CH+", style=shape.labelup,
     location=location.belowbar, color=color.lime, textcolor=color.black, size=size.tiny)
plotshape(bearBos and not bearChoch, "Bear BOS", text="BOS-", style=shape.labeldown,
     location=location.abovebar, color=color.red, textcolor=color.white, size=size.tiny)
plotshape(bearChoch, "Bear CHOCH", text="CH-", style=shape.labeldown,
     location=location.abovebar, color=color.orange, textcolor=color.black, size=size.tiny)

var box[] obBoxes = array.new_box()
var int[] obDirs = array.new_int()
var int[] obBorn = array.new_int()
var float[] obStrengths = array.new_float()
var box[] fvgBoxes = array.new_box()
var int[] fvgDirs = array.new_int()
var int[] fvgBorn = array.new_int()
var int bosCount = 0
var int breakerCount = 0
var int mitigatedCount = 0
var int fvgCount = 0

if barstate.isconfirmed and (bullBos or bearBos)
    bosCount += 1
    int selectedOffset = 1
    bool found = false
    int k = 1
    while k <= obSearch and not found
        bool opposite = bullBos ? close[k] < open[k] : close[k] > open[k]
        if opposite
            selectedOffset := k
            found := true
        k += 1
    float obTop = high[selectedOffset]
    float obBottom = low[selectedOffset]
    float strength = volMa[selectedOffset] > 0 ? volume[selectedOffset] / volMa[selectedOffset] : 1
    int obTransparency = showObActivity ? int(math.max(58, 90 - math.min(strength, 4) * 8)) : 82
    color obColor = bullBos ? color.new(color.aqua, obTransparency) : color.new(color.red, obTransparency)
    if showOb
        box bx = box.new(bar_index - selectedOffset, obTop, bar_index + maxAge, obBottom, xloc=xloc.bar_index,
             bgcolor=obColor, border_color=color.new(bullBos ? color.aqua : color.red, 45))
        array.push(obBoxes, bx)
        array.push(obDirs, bullBos ? 1 : -1)
        array.push(obBorn, bar_index)
        array.push(obStrengths, strength)
        if showMetrics
            label.new(bar_index - selectedOffset, bullBos ? obBottom : obTop,
                 "OB " + str.tostring(strength, "#.0") + "x",
                 style=bullBos ? label.style_label_up : label.style_label_down,
                 color=color.new(bullBos ? color.aqua : color.red, 35),
                 textcolor=bullBos ? color.black : color.white, size=f_text_size())

bool bullFvg = barstate.isconfirmed and low > high[2]
bool bearFvg = barstate.isconfirmed and high < low[2]
if showFvg and (bullFvg or bearFvg)
    float top = bullFvg ? low : low[2]
    float bottom = bullFvg ? high[2] : high
    color bullFvgColor = fvgTheme == "Classic" ? color.teal : color.lime
    color bearFvgColor = fvgTheme == "Classic" ? color.purple : color.orange
    box gap = box.new(bar_index - 2, top, bar_index + (extendFvg ? maxAge : 3), bottom, xloc=xloc.bar_index,
         bgcolor=color.new(bullFvg ? bullFvgColor : bearFvgColor, 84),
         border_color=color.new(bullFvg ? bullFvgColor : bearFvgColor, 48))
    array.push(fvgBoxes, gap)
    array.push(fvgDirs, bullFvg ? 1 : -1)
    array.push(fvgBorn, bar_index)
    fvgCount += 1

bool bullObSignal = false
bool bearObSignal = false
int oi = array.size(obBoxes) - 1
while oi >= 0
    box bx = array.get(obBoxes, oi)
    int dir = array.get(obDirs, oi)
    int born = array.get(obBorn, oi)
    float top = box.get_top(bx)
    float bottom = box.get_bottom(bx)
    float mid = (top + bottom) * 0.5
    bool touched = mitigation == "Close" ? close <= top and close >= bottom :
         mitigation == "Midpoint" ? low <= mid and high >= mid : low <= top and high >= bottom
    bool broken = dir == 1 ? close < bottom : close > top
    bool expired = bar_index - born > maxAge
    if broken
        if showBreakers
            box.set_bgcolor(bx, color.new(dir == 1 ? color.red : color.aqua, 88))
            box.set_border_color(bx, color.new(color.orange, 45))
            box.set_right(bx, bar_index + 40)
            breakerCount += 1
        else
            box.delete(bx)
        array.remove(obBoxes, oi)
        array.remove(obDirs, oi)
        array.remove(obBorn, oi)
        array.remove(obStrengths, oi)
    else if expired
        box.delete(bx)
        array.remove(obBoxes, oi)
        array.remove(obDirs, oi)
        array.remove(obBorn, oi)
        array.remove(obStrengths, oi)
    else
        box.set_right(bx, bar_index + 20)
        if touched and barstate.isconfirmed
            mitigatedCount += 1
            bullObSignal := dir == 1 and close > open
            bearObSignal := dir == -1 and close < open
            box.set_bgcolor(bx, color.new(dir == 1 ? color.aqua : color.red, 91))
    oi -= 1

while array.size(obBoxes) > keepOb
    box.delete(array.shift(obBoxes))
    array.shift(obDirs)
    array.shift(obBorn)
    array.shift(obStrengths)

bool bullFvgSignal = false
bool bearFvgSignal = false
int fi = array.size(fvgBoxes) - 1
while fi >= 0
    box gap = array.get(fvgBoxes, fi)
    int dir = array.get(fvgDirs, fi)
    int born = array.get(fvgBorn, fi)
    float top = box.get_top(gap)
    float bottom = box.get_bottom(gap)
    float mid = (top + bottom) * 0.5
    bool filled = fvgMitigation == "Close" ? (dir == 1 ? close <= bottom : close >= top) :
         fvgMitigation == "Midpoint" ? (dir == 1 ? low <= mid : high >= mid) :
         (dir == 1 ? low <= bottom : high >= top)
    bool touched = high >= bottom and low <= top
    if touched and not filled
        bullFvgSignal := dir == 1 and close > open
        bearFvgSignal := dir == -1 and close < open
    if filled or bar_index - born > maxAge
        box.set_right(gap, bar_index)
        box.set_bgcolor(gap, color.new(color.gray, 92))
        array.remove(fvgBoxes, fi)
        array.remove(fvgDirs, fi)
        array.remove(fvgBorn, fi)
    else if extendFvg
        box.set_right(gap, bar_index + 20)
    fi -= 1

while array.size(fvgBoxes) > keepFvg
    box.delete(array.shift(fvgBoxes))
    array.shift(fvgDirs)
    array.shift(fvgBorn)

f_last_htf_high() =>
    float p = ta.pivothigh(high, swingLen, swingLen)
    ta.valuewhen(not na(p), p, 0)
f_last_htf_low() =>
    float p = ta.pivotlow(low, swingLen, swingLen)
    ta.valuewhen(not na(p), p, 0)

float htfHigh = request.security(syminfo.tickerid, htf, f_last_htf_high(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
float htfLow = request.security(syminfo.tickerid, htf, f_last_htf_low(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
plot(showHtf ? htfHigh : na, "HTF supply", color=color.new(color.red, 55), style=plot.style_stepline)
plot(showHtf ? htfLow : na, "HTF demand", color=color.new(color.aqua, 55), style=plot.style_stepline)

f_last_htf_bull_fvg_top() => ta.valuewhen(low > high[2], low, 0)
f_last_htf_bull_fvg_bottom() => ta.valuewhen(low > high[2], high[2], 0)
f_last_htf_bear_fvg_top() => ta.valuewhen(high < low[2], low[2], 0)
f_last_htf_bear_fvg_bottom() => ta.valuewhen(high < low[2], high, 0)

float htfBullFvgTop = request.security(syminfo.tickerid, htf, f_last_htf_bull_fvg_top(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
float htfBullFvgBottom = request.security(syminfo.tickerid, htf, f_last_htf_bull_fvg_bottom(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
float htfBearFvgTop = request.security(syminfo.tickerid, htf, f_last_htf_bear_fvg_top(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
float htfBearFvgBottom = request.security(syminfo.tickerid, htf, f_last_htf_bear_fvg_bottom(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
pHtfBullTop = plot(showFvgHtf ? htfBullFvgTop : na, "HTF bull FVG top", color=color.new(color.aqua, 58), style=plot.style_stepline)
pHtfBullBottom = plot(showFvgHtf ? htfBullFvgBottom : na, "HTF bull FVG bottom", color=color.new(color.aqua, 58), style=plot.style_stepline)
pHtfBearTop = plot(showFvgHtf ? htfBearFvgTop : na, "HTF bear FVG top", color=color.new(color.red, 58), style=plot.style_stepline)
pHtfBearBottom = plot(showFvgHtf ? htfBearFvgBottom : na, "HTF bear FVG bottom", color=color.new(color.red, 58), style=plot.style_stepline)
fill(pHtfBullTop, pHtfBullBottom, color=color.new(color.aqua, 91), title="HTF bull FVG")
fill(pHtfBearTop, pHtfBearBottom, color=color.new(color.red, 91), title="HTF bear FVG")

plot(showPredict ? lastSwingHigh : na, "Projected swing high", color=color.new(color.red, 72), style=plot.style_stepline)
plot(showPredict ? lastSwingLow : na, "Projected swing low", color=color.new(color.aqua, 72), style=plot.style_stepline)

float rsi = ta.rsi(close, 14)
float smartHtfRsi = request.security(syminfo.tickerid, smartRevHtf, ta.rsi(close, 14), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
bool smartBull = showSmartRev and barstate.isconfirmed and not na(pl) and rsi < 38 and smartHtfRsi <= 55 and close > open and structureTrend >= 0
bool smartBear = showSmartRev and barstate.isconfirmed and not na(ph) and rsi > 62 and smartHtfRsi >= 45 and close < open and structureTrend <= 0
bool finalBullSignal = showSignals and ((showObSignals and bullObSignal) or (showFvgSignals and bullFvgSignal) or smartBull)
bool finalBearSignal = showSignals and ((showObSignals and bearObSignal) or (showFvgSignals and bearFvgSignal) or smartBear)
plotshape(finalBullSignal, "SMC buy", text="SMC+", style=shape.labelup, location=location.belowbar, color=color.aqua, textcolor=color.black, size=size.tiny)
plotshape(finalBearSignal, "SMC sell", text="SMC-", style=shape.labeldown, location=location.abovebar, color=color.red, textcolor=color.white, size=size.tiny)

var table stats = table.new(f_stats_position(), 2, 7, bgcolor=color.new(color.rgb(10, 14, 21), 10), border_width=1)
if barstate.islast
    if statsType != "Off"
        table.cell(stats, 0, 0, "SMART RANGES", text_color=color.white, bgcolor=color.rgb(28, 35, 46))
        table.cell(stats, 1, 0, structureTrend > 0 ? "BULL" : structureTrend < 0 ? "BEAR" : "NEUTRAL",
             text_color=structureTrend > 0 ? color.aqua : structureTrend < 0 ? color.red : color.gray, bgcolor=color.rgb(28, 35, 46))
        table.cell(stats, 0, 1, "BOS", text_color=color.silver)
        table.cell(stats, 1, 1, str.tostring(bosCount), text_color=color.white)
        table.cell(stats, 0, 2, "Active OB", text_color=color.silver)
        table.cell(stats, 1, 2, str.tostring(array.size(obBoxes)), text_color=color.aqua)
        table.cell(stats, 0, 3, "Breakers", text_color=color.silver)
        table.cell(stats, 1, 3, str.tostring(breakerCount), text_color=color.orange)
        table.cell(stats, 0, 4, "FVG / Active", text_color=color.silver)
        table.cell(stats, 1, 4, str.tostring(fvgCount) + " / " + str.tostring(array.size(fvgBoxes)), text_color=color.fuchsia)
        table.cell(stats, 0, 5, "Mitigations", text_color=color.silver)
        table.cell(stats, 1, 5, str.tostring(mitigatedCount), text_color=color.yellow)
        table.cell(stats, 0, 6, statsType == "Detailed" ? "HTF / Rev RSI" : "Mode", text_color=color.silver)
        table.cell(stats, 1, 6, statsType == "Detailed" ? htf + " / " + str.tostring(smartHtfRsi, "#.0") : "SUMMARY", text_color=color.white)
    else
        table.clear(stats, 0, 0, 1, 6)

alertcondition(bullBos, "Bullish BOS", "Bullish break of structure on {{ticker}} {{interval}}")
alertcondition(bearBos, "Bearish BOS", "Bearish break of structure on {{ticker}} {{interval}}")
alertcondition(finalBullSignal, "Smart Ranges buy", "SMC demand/FVG signal on {{ticker}} {{interval}}")
alertcondition(finalBearSignal, "Smart Ranges sell", "SMC supply/FVG signal on {{ticker}} {{interval}}")
