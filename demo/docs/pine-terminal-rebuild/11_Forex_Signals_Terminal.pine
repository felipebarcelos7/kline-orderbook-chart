// Independent reconstruction of the terminal Forex Signals model.
// Signals are committed on confirmed candles and never use lookahead.
// SPDX-License-Identifier: MPL-2.0
//@version=6
indicator("Select Terminal - Forex Signals [Event Loop v3]", "Select FX Signals v3",
     overlay=true, scale=scale.none, max_bars_back=3000, max_labels_count=500, max_lines_count=100, max_boxes_count=50)

string G_MODEL = "Signal Model"
string signalMode = input.string("All", "Signal mode v3", options=["All", "Main only"], group=G_MODEL)
int mainSwingInput = input.int(5, "Main pivot bars", minval=2, maxval=20, group=G_MODEL)
int minorSwingInput = input.int(3, "DCA pivot bars", minval=2, maxval=12, group=G_MODEL)
int minMainScore = input.int(55, "Minimum Main score", minval=40, maxval=100, group=G_MODEL)
int minDcaScore = input.int(50, "Minimum DCA score", minval=35, maxval=100, group=G_MODEL)
int minSignalBars = input.int(8, "Minimum bars between signals", minval=0, maxval=100, group=G_MODEL)
int exhaustionLookback = input.int(24, "Exhaustion lookback", minval=5, maxval=100, group=G_MODEL)
bool colorTrendCandles = input.bool(true, "Trend-colored candles", group=G_MODEL)

string G_BTC = "BTC Confluence"
bool useBtcConfluence = input.bool(true, "Use BTC confluence for altcoins", group=G_BTC)
string btcSymbol = input.symbol("BINANCE:BTCUSDT.P", "BTC symbol", group=G_BTC)
string btcTimeframe = input.timeframe("", "BTC timeframe (empty = chart)", group=G_BTC)

string G_RISK = "Entry, Risk and Targets"
float entryAtrWidth = input.float(0.20, "Entry zone ATR width", minval=0.05, maxval=2, step=0.05, group=G_RISK)
float minimumRiskAtr = input.float(0.80, "Minimum risk ATR", minval=0.25, maxval=5, step=0.05, group=G_RISK)
float tp1R = input.float(0.8, "TP1 R", minval=0.1, step=0.1, group=G_RISK)
float tp2R = input.float(1.0, "TP2 R", minval=0.2, step=0.1, group=G_RISK)
float tp3R = input.float(1.3, "TP3 R", minval=0.3, step=0.1, group=G_RISK)
float tp4R = input.float(1.6, "TP4 R", minval=0.4, step=0.1, group=G_RISK)
float tp5R = input.float(2.0, "TP5 R", minval=0.5, step=0.1, group=G_RISK)
float tp6R = input.float(2.5, "TP6 R", minval=0.6, step=0.1, group=G_RISK)
float trailingAtr = input.float(1.5, "Trailing stop ATR after TP5", minval=0.25, maxval=5, step=0.1, group=G_RISK)

string G_VISUAL = "Visuals"
bool showTradePlan = input.bool(true, "Show ET/TP/SL plan", group=G_VISUAL)
bool showHitMarkers = input.bool(true, "Show TP/SL hit markers", group=G_VISUAL)
bool showMaxProfit = input.bool(true, "Show max profit marker", group=G_VISUAL)
string textSizeInput = input.string("Small", "Text size", options=["Tiny", "Small", "Normal"], group=G_VISUAL)

f_text_size() =>
    textSizeInput == "Tiny" ? size.tiny : textSizeInput == "Normal" ? size.normal : size.small

bool supportedTimeframe = timeframe.isminutes and (timeframe.multiplier == 5 or timeframe.multiplier == 15 or timeframe.multiplier == 30)
int mainSwing = timeframe.isminutes and timeframe.multiplier == 5 ? 5 : timeframe.isminutes and timeframe.multiplier == 15 ? 6 :
     timeframe.isminutes and timeframe.multiplier == 30 ? 7 : mainSwingInput
int minorSwing = timeframe.isminutes and timeframe.multiplier == 5 ? 3 : timeframe.isminutes and timeframe.multiplier == 15 ? 4 :
     timeframe.isminutes and timeframe.multiplier == 30 ? 5 : minorSwingInput

float atr = ta.atr(14)
float rsi = ta.rsi(close, 14)
float emaFast = ta.ema(close, 21)
float emaSlow = ta.ema(close, 55)
float volMa = ta.sma(volume, 30)
float volSd = ta.stdev(volume, 30)
float volZ = volSd > 0 ? (volume - volMa) / volSd : 0

[btcClose, btcFast, btcSlow, btcRsi] = request.security(btcSymbol, btcTimeframe,
     [close, ta.ema(close, 21), ta.ema(close, 55), ta.rsi(close, 14)],
     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)

bool isBtcChart = str.contains(str.upper(syminfo.ticker), "BTC")
bool btcAvailable = not na(btcClose) and not na(btcFast) and not na(btcSlow)
bool btcBull = not btcAvailable or btcFast >= btcSlow and btcRsi >= 47
bool btcBear = not btcAvailable or btcFast <= btcSlow and btcRsi <= 53
bool longBtcOk = not useBtcConfluence or isBtcChart or btcBull
bool shortBtcOk = not useBtcConfluence or isBtcChart or btcBear

float mainPivotHigh = ta.pivothigh(high, mainSwing, mainSwing)
float mainPivotLow = ta.pivotlow(low, mainSwing, mainSwing)
float minorPivotHigh = ta.pivothigh(high, minorSwing, minorSwing)
float minorPivotLow = ta.pivotlow(low, minorSwing, minorSwing)

var float lastMainHigh = na
var float previousMainHigh = na
var float lastMainLow = na
var float previousMainLow = na
var float lastMinorHigh = na
var float lastMinorLow = na
var int lastMainHighBar = na
var int lastMainLowBar = na

if not na(mainPivotHigh)
    previousMainHigh := lastMainHigh
    lastMainHigh := mainPivotHigh
    lastMainHighBar := bar_index - mainSwing
if not na(mainPivotLow)
    previousMainLow := lastMainLow
    lastMainLow := mainPivotLow
    lastMainLowBar := bar_index - mainSwing
if not na(minorPivotHigh)
    lastMinorHigh := minorPivotHigh
if not na(minorPivotLow)
    lastMinorLow := minorPivotLow

bool bullishMainBreak = barstate.isconfirmed and not na(lastMainHigh) and close > lastMainHigh and close[1] <= lastMainHigh
bool bearishMainBreak = barstate.isconfirmed and not na(lastMainLow) and close < lastMainLow and close[1] >= lastMainLow
bool bullishMinorBreak = barstate.isconfirmed and not na(lastMinorHigh) and close > lastMinorHigh and close[1] <= lastMinorHigh
bool bearishMinorBreak = barstate.isconfirmed and not na(lastMinorLow) and close < lastMinorLow and close[1] >= lastMinorLow

bool recentLowPivot = not na(lastMainLowBar) and bar_index - lastMainLowBar <= exhaustionLookback
bool recentHighPivot = not na(lastMainHighBar) and bar_index - lastMainHighBar <= exhaustionLookback
float lowestRsi = ta.lowest(rsi, exhaustionLookback)
float highestRsi = ta.highest(rsi, exhaustionLookback)
bool bullishExhaustion = recentLowPivot and lowestRsi < 42 and rsi > rsi[1]
bool bearishExhaustion = recentHighPivot and highestRsi > 58 and rsi < rsi[1]

int longMainScore = 40 + (bullishExhaustion ? 20 : 0) + (emaFast >= emaSlow ? 15 : 0) +
     (volZ >= 0.5 ? 10 : 0) + (longBtcOk ? 15 : 0)
int shortMainScore = 40 + (bearishExhaustion ? 20 : 0) + (emaFast <= emaSlow ? 15 : 0) +
     (volZ >= 0.5 ? 10 : 0) + (shortBtcOk ? 15 : 0)
int longDcaScore = 35 + (emaFast >= emaSlow ? 20 : 0) + (rsi >= 50 ? 15 : 0) +
     (volZ >= 0 ? 10 : 0) + (longBtcOk ? 20 : 0)
int shortDcaScore = 35 + (emaFast <= emaSlow ? 20 : 0) + (rsi <= 50 ? 15 : 0) +
     (volZ >= 0 ? 10 : 0) + (shortBtcOk ? 20 : 0)

var int marketTrend = 0
var int lastSignalBar = na
bool spacingOk = na(lastSignalBar) or bar_index - lastSignalBar >= minSignalBars
bool mainBuy = bullishMainBreak and marketTrend <= 0 and longMainScore >= minMainScore and longBtcOk and spacingOk
bool mainSell = bearishMainBreak and marketTrend >= 0 and shortMainScore >= minMainScore and shortBtcOk and spacingOk
bool dcaBuy = signalMode == "All" and marketTrend == 1 and bullishMinorBreak and not mainBuy and longDcaScore >= minDcaScore and longBtcOk and spacingOk
bool dcaSell = signalMode == "All" and marketTrend == -1 and bearishMinorBreak and not mainSell and shortDcaScore >= minDcaScore and shortBtcOk and spacingOk
bool newSignal = mainBuy or mainSell or dcaBuy or dcaSell
int newDirection = mainBuy or dcaBuy ? 1 : mainSell or dcaSell ? -1 : 0
bool newMainSignal = mainBuy or mainSell

if mainBuy
    marketTrend := 1
if mainSell
    marketTrend := -1
if newSignal
    lastSignalBar := bar_index

plotshape(mainBuy, "Main buy", text="BUY M", style=shape.labelup, location=location.belowbar,
     color=color.rgb(0, 220, 165), textcolor=color.black, size=size.small)
plotshape(mainSell, "Main sell", text="SELL M", style=shape.labeldown, location=location.abovebar,
     color=color.rgb(255, 62, 82), textcolor=color.white, size=size.small)
plotshape(dcaBuy, "DCA buy", text="BUY D", style=shape.labelup, location=location.belowbar,
     color=color.new(color.aqua, 5), textcolor=color.black, size=size.tiny)
plotshape(dcaSell, "DCA sell", text="SELL D", style=shape.labeldown, location=location.abovebar,
     color=color.new(color.orange, 5), textcolor=color.black, size=size.tiny)

color trendCandleColor = marketTrend == 1 ? color.new(color.rgb(0, 205, 175), 18) :
     marketTrend == -1 ? color.new(color.rgb(255, 55, 75), 18) : na
barcolor(colorTrendCandles ? trendCandleColor : na)

var bool tradeActive = false
var bool entryTriggered = false
var int tradeDirection = 0
var bool tradeIsMain = false
var int tradeOpenBar = na
var float et1 = na
var float et2 = na
var float averageEntry = na
var float stopLoss = na
var float target1 = na
var float target2 = na
var float target3 = na
var float target4 = na
var float target5 = na
var float target6 = na
var float trailingStop = na
var int trailingStartBar = na
var bool hit1 = false
var bool hit2 = false
var bool hit3 = false
var bool hit4 = false
var bool hit5 = false
var bool hit6 = false
var float maxProfitPrice = na
var int maxProfitBar = na

var int mainSignals = 0
var int dcaSignals = 0
var int wins = 0
var int losses = 0
var int expired = 0
var int tp1Hits = 0
var int tp5Hits = 0
var int tp6Hits = 0

if newSignal
    if tradeActive
        expired += 1
    tradeDirection := newDirection
    tradeIsMain := newMainSignal
    tradeOpenBar := bar_index
    float brokenLevel = newDirection == 1 ? (newMainSignal ? lastMainHigh : lastMinorHigh) :
         (newMainSignal ? lastMainLow : lastMinorLow)
    et1 := nz(brokenLevel, close)
    et2 := open
    float zoneMidpoint = (et1 + et2) * 0.5
    float zoneOffset = atr * entryAtrWidth
    et1 := newDirection == 1 ? math.min(et1, zoneMidpoint - zoneOffset * 0.25) : math.max(et1, zoneMidpoint + zoneOffset * 0.25)
    et2 := newDirection == 1 ? math.max(et2, zoneMidpoint + zoneOffset * 0.25) : math.min(et2, zoneMidpoint - zoneOffset * 0.25)
    averageEntry := (et1 + et2) * 0.5
    float minimumRisk = math.max(atr * minimumRiskAtr, syminfo.mintick * 10)
    float structuralStop = newDirection == 1 ? nz(lastMainLow, averageEntry - minimumRisk) : nz(lastMainHigh, averageEntry + minimumRisk)
    stopLoss := newDirection == 1 ? math.min(structuralStop, averageEntry - minimumRisk) : math.max(structuralStop, averageEntry + minimumRisk)
    float risk = math.max(math.abs(averageEntry - stopLoss), syminfo.mintick * 10)
    target1 := averageEntry + newDirection * risk * tp1R
    target2 := averageEntry + newDirection * risk * tp2R
    target3 := averageEntry + newDirection * risk * tp3R
    target4 := averageEntry + newDirection * risk * tp4R
    target5 := averageEntry + newDirection * risk * tp5R
    target6 := averageEntry + newDirection * risk * tp6R
    trailingStop := na
    trailingStartBar := na
    hit1 := false
    hit2 := false
    hit3 := false
    hit4 := false
    hit5 := false
    hit6 := false
    entryTriggered := false
    tradeActive := true
    maxProfitPrice := close
    maxProfitBar := bar_index
    if newMainSignal
        mainSignals += 1
    else
        dcaSignals += 1

bool newTp1 = false
bool newTp2 = false
bool newTp3 = false
bool newTp4 = false
bool newTp5 = false
bool newTp6 = false
bool newStopHit = false

if tradeActive
    float zoneLow = math.min(et1, et2)
    float zoneHigh = math.max(et1, et2)
    if not entryTriggered and bar_index >= tradeOpenBar and high >= zoneLow and low <= zoneHigh
        entryTriggered := true
    if entryTriggered
        bool fixedStopHit = tradeDirection == 1 ? low <= stopLoss : high >= stopLoss
        bool trailingHit = not na(trailingStop) and bar_index > nz(trailingStartBar, bar_index) and
             (tradeDirection == 1 ? low <= trailingStop : high >= trailingStop)
        if fixedStopHit or trailingHit
            newStopHit := true
            tradeActive := false
            if hit1
                wins += 1
            else
                losses += 1
        else
            if tradeDirection == 1
                newTp1 := not hit1 and high >= target1
                newTp2 := not hit2 and high >= target2
                newTp3 := not hit3 and high >= target3
                newTp4 := not hit4 and high >= target4
                newTp5 := not hit5 and high >= target5
                newTp6 := not hit6 and high >= target6
            else
                newTp1 := not hit1 and low <= target1
                newTp2 := not hit2 and low <= target2
                newTp3 := not hit3 and low <= target3
                newTp4 := not hit4 and low <= target4
                newTp5 := not hit5 and low <= target5
                newTp6 := not hit6 and low <= target6
            if newTp1
                hit1 := true
                tp1Hits += 1
            if newTp2
                hit2 := true
            if newTp3
                hit3 := true
            if newTp4
                hit4 := true
            if newTp5
                hit5 := true
                tp5Hits += 1
                trailingStartBar := bar_index
                trailingStop := tradeDirection == 1 ? math.max(stopLoss, close - atr * trailingAtr) : math.min(stopLoss, close + atr * trailingAtr)
            if newTp6
                hit6 := true
                tp6Hits += 1
            if hit5
                float nextTrail = tradeDirection == 1 ? close - atr * trailingAtr : close + atr * trailingAtr
                trailingStop := tradeDirection == 1 ? math.max(nz(trailingStop, stopLoss), nextTrail) : math.min(nz(trailingStop, stopLoss), nextTrail)
            float favorablePrice = tradeDirection == 1 ? high : low
            bool improves = na(maxProfitPrice) or (tradeDirection == 1 ? favorablePrice > maxProfitPrice : favorablePrice < maxProfitPrice)
            if improves
                maxProfitPrice := favorablePrice
                maxProfitBar := bar_index

bool planExists = showTradePlan and not na(averageEntry)

plotshape(showHitMarkers and newTp1 ? target1 : na, "TP1 hit", text="1", location=location.absolute, style=shape.circle, color=color.lime, textcolor=color.black, size=size.tiny)
plotshape(showHitMarkers and newTp2 ? target2 : na, "TP2 hit", text="2", location=location.absolute, style=shape.circle, color=color.lime, textcolor=color.black, size=size.tiny)
plotshape(showHitMarkers and newTp3 ? target3 : na, "TP3 hit", text="3", location=location.absolute, style=shape.circle, color=color.lime, textcolor=color.black, size=size.tiny)
plotshape(showHitMarkers and newTp4 ? target4 : na, "TP4 hit", text="4", location=location.absolute, style=shape.circle, color=color.lime, textcolor=color.black, size=size.tiny)
plotshape(showHitMarkers and newTp5 ? target5 : na, "TP5 hit", text="5", location=location.absolute, style=shape.circle, color=color.lime, textcolor=color.black, size=size.tiny)
plotshape(showHitMarkers and newTp6 ? target6 : na, "TP6 hit", text="6", location=location.absolute, style=shape.circle, color=color.lime, textcolor=color.black, size=size.tiny)
plotshape(showHitMarkers and newStopHit ? (na(trailingStop) ? stopLoss : trailingStop) : na, "Stop hit", text="SL", location=location.absolute, style=shape.labeldown, color=color.red, textcolor=color.white, size=size.tiny)

var line[] planLines = array.new_line()
var label[] planLabels = array.new_label()
var box entryZoneBox = na
var label maxProfitLabel = na
f_plan_line(int startBar, int endBar, float levelPrice, color lineColor, int lineWidth) =>
    line.new(startBar, levelPrice, endBar, levelPrice, xloc=xloc.bar_index, extend=extend.none,
         color=lineColor, style=line.style_dashed, width=lineWidth)
f_plan_label(int labelBar, float price, string labelText, color labelColor) =>
    label.new(labelBar, price, labelText + " " + str.tostring(price, format.mintick), xloc=xloc.bar_index,
         style=label.style_label_left, color=color.new(labelColor, 72), textcolor=color.white, size=f_text_size())

if barstate.islast
    while array.size(planLines) > 0
        line.delete(array.pop(planLines))
    while array.size(planLabels) > 0
        label.delete(array.pop(planLabels))
    if not na(entryZoneBox)
        box.delete(entryZoneBox)
        entryZoneBox := na
    if not na(maxProfitLabel)
        label.delete(maxProfitLabel)
        maxProfitLabel := na
    if planExists
        int planStartBar = nz(tradeOpenBar, bar_index)
        int planEndBar = bar_index + 18
        entryZoneBox := box.new(planStartBar, math.max(et1, et2), planEndBar, math.min(et1, et2),
             xloc=xloc.bar_index, border_color=color.new(color.aqua, 30),
             bgcolor=color.new(tradeDirection == 1 ? color.teal : color.red, tradeActive ? 86 : 93))
        array.push(planLines, f_plan_line(planStartBar, planEndBar, et1, color.new(color.aqua, 12), 1))
        array.push(planLines, f_plan_line(planStartBar, planEndBar, et2, color.new(color.aqua, 12), 1))
        array.push(planLines, f_plan_line(planStartBar, planEndBar, averageEntry, color.white, 1))
        array.push(planLines, f_plan_line(planStartBar, planEndBar, stopLoss, color.red, 2))
        array.push(planLines, f_plan_line(planStartBar, planEndBar, target1, hit1 ? color.lime : color.new(color.lime, 45), 1))
        array.push(planLines, f_plan_line(planStartBar, planEndBar, target2, hit2 ? color.lime : color.new(color.lime, 45), 1))
        array.push(planLines, f_plan_line(planStartBar, planEndBar, target3, hit3 ? color.lime : color.new(color.lime, 45), 1))
        array.push(planLines, f_plan_line(planStartBar, planEndBar, target4, hit4 ? color.lime : color.new(color.lime, 45), 1))
        array.push(planLines, f_plan_line(planStartBar, planEndBar, target5, hit5 ? color.lime : color.new(color.lime, 45), 1))
        array.push(planLines, f_plan_line(planStartBar, planEndBar, target6, hit6 ? color.lime : color.new(color.lime, 45), 1))
        if not na(trailingStop)
            array.push(planLines, f_plan_line(planStartBar, planEndBar, trailingStop, color.orange, 2))
        array.push(planLabels, f_plan_label(planEndBar, et1, "ET1", color.aqua))
        array.push(planLabels, f_plan_label(planEndBar, et2, "ET2", color.aqua))
        array.push(planLabels, f_plan_label(planEndBar, averageEntry, "AVG", color.white))
        array.push(planLabels, f_plan_label(planEndBar, stopLoss, "SL", color.red))
        array.push(planLabels, f_plan_label(planEndBar, target1, "TP1", color.lime))
        array.push(planLabels, f_plan_label(planEndBar, target2, "TP2", color.lime))
        array.push(planLabels, f_plan_label(planEndBar, target3, "TP3", color.lime))
        array.push(planLabels, f_plan_label(planEndBar, target4, "TP4", color.lime))
        array.push(planLabels, f_plan_label(planEndBar, target5, "TP5", color.lime))
        array.push(planLabels, f_plan_label(planEndBar, target6, "TP6", color.lime))
    if showMaxProfit and not na(maxProfitPrice) and not na(maxProfitBar)
        float maxPct = averageEntry != 0 ? math.abs(maxProfitPrice - averageEntry) / averageEntry * 1000 : 0
        maxProfitLabel := label.new(maxProfitBar, maxProfitPrice, "Max " + str.tostring(maxPct, "#.00") + "% 10x",
             xloc=xloc.bar_index, style=tradeDirection == 1 ? label.style_label_down : label.style_label_up,
             color=color.new(color.green, 20), textcolor=color.white, size=f_text_size())

var table statusTable = table.new(position.top_right, 2, 10, border_width=1,
     bgcolor=color.new(color.rgb(10, 14, 21), 8), frame_color=color.new(color.gray, 70))
if barstate.islast
    string statusText = tradeActive ? (tradeDirection == 1 ? "ACTIVE BUY" : "ACTIVE SELL") : "WAITING SIGNAL"
    color statusColor = tradeActive ? (tradeDirection == 1 ? color.aqua : color.red) : color.yellow
    table.cell(statusTable, 0, 0, "FX SIGNALS V3", text_color=color.white, bgcolor=color.rgb(28, 35, 46))
    table.cell(statusTable, 1, 0, statusText, text_color=statusColor, bgcolor=color.rgb(28, 35, 46))
    table.cell(statusTable, 0, 1, "Timeframe", text_color=color.silver)
    table.cell(statusTable, 1, 1, timeframe.period + (supportedTimeframe ? " OK" : " USE 5/15/30"), text_color=supportedTimeframe ? color.aqua : color.orange)
    table.cell(statusTable, 0, 2, "Trend", text_color=color.silver)
    table.cell(statusTable, 1, 2, marketTrend == 1 ? "BULL" : marketTrend == -1 ? "BEAR" : "DISCOVERY", text_color=marketTrend == 1 ? color.aqua : marketTrend == -1 ? color.red : color.yellow)
    table.cell(statusTable, 0, 3, "Main score B/S", text_color=color.silver)
    table.cell(statusTable, 1, 3, str.tostring(longMainScore) + " / " + str.tostring(shortMainScore), text_color=color.white)
    table.cell(statusTable, 0, 4, "Signals M/D", text_color=color.silver)
    table.cell(statusTable, 1, 4, str.tostring(mainSignals) + " / " + str.tostring(dcaSignals), text_color=color.white)
    table.cell(statusTable, 0, 5, "Wins / Losses", text_color=color.silver)
    table.cell(statusTable, 1, 5, str.tostring(wins) + " / " + str.tostring(losses), text_color=wins >= losses ? color.aqua : color.red)
    table.cell(statusTable, 0, 6, "TP1 / TP5 / TP6", text_color=color.silver)
    table.cell(statusTable, 1, 6, str.tostring(tp1Hits) + " / " + str.tostring(tp5Hits) + " / " + str.tostring(tp6Hits), text_color=color.lime)
    table.cell(statusTable, 0, 7, "Expired", text_color=color.silver)
    table.cell(statusTable, 1, 7, str.tostring(expired), text_color=color.orange)
    table.cell(statusTable, 0, 8, "BTC confluence", text_color=color.silver)
    table.cell(statusTable, 1, 8, isBtcChart ? "BTC CHART" : longBtcOk ? "LONG" : shortBtcOk ? "SHORT" : "BLOCKED", text_color=longBtcOk ? color.aqua : shortBtcOk ? color.red : color.orange)
    table.cell(statusTable, 0, 9, "Pivots H/L", text_color=color.silver)
    table.cell(statusTable, 1, 9, (na(lastMainHigh) ? "-" : str.tostring(lastMainHigh, format.mintick)) + " / " +
         (na(lastMainLow) ? "-" : str.tostring(lastMainLow, format.mintick)), text_color=color.white)

alertcondition(mainBuy, "FX Main Buy", "Main BUY on {{ticker}} {{interval}}")
alertcondition(mainSell, "FX Main Sell", "Main SELL on {{ticker}} {{interval}}")
alertcondition(dcaBuy, "FX DCA Buy", "DCA BUY on {{ticker}} {{interval}}")
alertcondition(dcaSell, "FX DCA Sell", "DCA SELL on {{ticker}} {{interval}}")
alertcondition(newTp5, "FX TP5 hit", "TP5 hit; trailing stop activated on {{ticker}} {{interval}}")
alertcondition(newTp6, "FX TP6 hit", "TP6 hit; trailing stop remains active on {{ticker}} {{interval}}")
alertcondition(newStopHit, "FX stop hit", "Stop or trailing stop hit on {{ticker}} {{interval}}")
