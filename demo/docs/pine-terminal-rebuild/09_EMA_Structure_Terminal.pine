// Multi-period EMA/WMA trend structure with BOS detection.
// SPDX-License-Identifier: MPL-2.0
//@version=6
indicator("Select Terminal - EMA Structure [Event Loop]", "Select EMA Structure", overlay=true, max_labels_count=300, max_lines_count=100)

string G_EMA = "EMA Structure"
int ema1Len = input.int(9, "Fast EMA", minval=1, group=G_EMA)
int ema2Len = input.int(21, "Slow EMA", minval=2, group=G_EMA)
int wmaLen = input.int(50, "WMA", minval=2, group=G_EMA)
int swingLen = input.int(5, "Swing length", minval=2, maxval=30, group=G_EMA)
bool showEma1 = input.bool(true, "Show fast EMA", group=G_EMA)
bool showEma2 = input.bool(true, "Show slow EMA", group=G_EMA)
bool showWma = input.bool(true, "Show WMA", group=G_EMA)
bool showBos = input.bool(true, "Show BOS", group=G_EMA)
bool colorCandles = input.bool(true, "Trend-colored candles", group=G_EMA)
bool showStats = input.bool(true, "Show dashboard", group=G_EMA)

float ema1 = ta.ema(close, ema1Len)
float ema2 = ta.ema(close, ema2Len)
float wma = ta.wma(close, wmaLen)
float atr = ta.atr(14)
float spread = math.abs(ema1 - ema2) / math.max(atr, syminfo.mintick)
bool bullStack = ema1 > ema2 and ema2 > wma
bool bearStack = ema1 < ema2 and ema2 < wma
bool bullTransition = ta.crossover(ema1, ema2)
bool bearTransition = ta.crossunder(ema1, ema2)

pFast = plot(showEma1 ? ema1 : na, "EMA fast", color=color.rgb(0, 220, 190), linewidth=2)
pSlow = plot(showEma2 ? ema2 : na, "EMA slow", color=color.rgb(122, 92, 246), linewidth=2)
plot(showWma ? wma : na, "WMA", color=color.rgb(245, 158, 11), linewidth=2)
fill(pFast, pSlow, color=ema1 >= ema2 ? color.new(color.aqua, 84) : color.new(color.red, 84), title="EMA cloud")

float ph = ta.pivothigh(high, swingLen, swingLen)
float pl = ta.pivotlow(low, swingLen, swingLen)
var float lastHigh = na
var float lastLow = na
if not na(ph)
    lastHigh := ph
if not na(pl)
    lastLow := pl
bool bullBos = barstate.isconfirmed and bullStack and not na(lastHigh) and close > lastHigh and close[1] <= lastHigh
bool bearBos = barstate.isconfirmed and bearStack and not na(lastLow) and close < lastLow and close[1] >= lastLow

var int trend = 0
var int bullBosCount = 0
var int bearBosCount = 0
if barstate.isconfirmed
    if bullStack
        trend := 1
    else if bearStack
        trend := -1
    if bullBos
        bullBosCount += 1
    if bearBos
        bearBosCount += 1

plotshape(showBos and bullBos, "Bull BOS", text="BOS+", style=shape.labelup, location=location.belowbar,
     color=color.aqua, textcolor=color.black, size=size.tiny)
plotshape(showBos and bearBos, "Bear BOS", text="BOS-", style=shape.labeldown, location=location.abovebar,
     color=color.red, textcolor=color.white, size=size.tiny)
plotshape(bullTransition, "Bull transition", text="EMA+", style=shape.triangleup, location=location.belowbar,
     color=color.new(color.aqua, 15), textcolor=color.black, size=size.tiny)
plotshape(bearTransition, "Bear transition", text="EMA-", style=shape.triangledown, location=location.abovebar,
     color=color.new(color.red, 15), textcolor=color.white, size=size.tiny)

color candleColor = bullStack ? (close >= open ? color.rgb(0, 205, 175) : color.rgb(88, 125, 118)) :
     bearStack ? (close <= open ? color.rgb(255, 55, 75) : color.rgb(132, 94, 100)) : color.gray
barcolor(colorCandles ? candleColor : na)

var table stats = table.new(position.top_right, 2, 6, bgcolor=color.new(color.rgb(10, 14, 21), 10), border_width=1)
if barstate.islast
    if showStats
        table.cell(stats, 0, 0, "EMA STRUCTURE", text_color=color.white, bgcolor=color.rgb(28, 35, 46))
        table.cell(stats, 1, 0, trend > 0 ? "BULL" : trend < 0 ? "BEAR" : "NEUTRAL",
             text_color=trend > 0 ? color.aqua : trend < 0 ? color.red : color.gray, bgcolor=color.rgb(28, 35, 46))
        table.cell(stats, 0, 1, "EMA spread", text_color=color.silver)
        table.cell(stats, 1, 1, str.tostring(spread, "#.00") + " ATR", text_color=spread > 0.5 ? color.yellow : color.white)
        table.cell(stats, 0, 2, "Fast EMA", text_color=color.silver)
        table.cell(stats, 1, 2, str.tostring(ema1, format.mintick), text_color=color.aqua)
        table.cell(stats, 0, 3, "Slow EMA", text_color=color.silver)
        table.cell(stats, 1, 3, str.tostring(ema2, format.mintick), text_color=color.rgb(150, 110, 255))
        table.cell(stats, 0, 4, "WMA", text_color=color.silver)
        table.cell(stats, 1, 4, str.tostring(wma, format.mintick), text_color=color.orange)
        table.cell(stats, 0, 5, "BOS B / S", text_color=color.silver)
        table.cell(stats, 1, 5, str.tostring(bullBosCount) + " / " + str.tostring(bearBosCount), text_color=color.white)
    else
        table.clear(stats, 0, 0, 1, 5)

alertcondition(bullTransition, "EMA bullish transition", "Bullish EMA transition on {{ticker}} {{interval}}")
alertcondition(bearTransition, "EMA bearish transition", "Bearish EMA transition on {{ticker}} {{interval}}")
alertcondition(bullBos, "EMA bullish BOS", "EMA structure bullish BOS on {{ticker}} {{interval}}")
alertcondition(bearBos, "EMA bearish BOS", "EMA structure bearish BOS on {{ticker}} {{interval}}")

